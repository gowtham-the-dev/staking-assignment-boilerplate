# ─────────────────────────────────────────────────────────────
# TADA Protocol Testnet (staking network)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TADA_CHAIN_ID=31451
NEXT_PUBLIC_TADA_RPC_URL=https://full.tada-protocol-testnet.xyz/jsonrpc
NEXT_PUBLIC_TADA_EXPLORER_URL=https://blockscout.tada-protocol-testnet.xyz

# Contract addresses. Optional in the starter; missing values fall back to lib/networks.ts defaults.
# MasterChefSingleEvent, deployed on TADA L1.
NEXT_PUBLIC_TADA_MASTERCHEF_ADDRESS=0x911843299861A4db1F6390184BbC54D203E50a9B
# A_MVL, reward token for both pools and pool0 deposit token.
NEXT_PUBLIC_TADA_STAKING_TOKEN_ADDRESS=0xa9728bf6a4cb2646e4E6E6B074CCc5305DBC904f
# B_MVL, pool1 deposit token and wallet tab display token.
NEXT_PUBLIC_TADA_STAKING_TOKEN_ADDRESS_B=0x8999b932877c854df9Ce4EEC737cb0CdFEC48A18

# Default pool, pool0. For multi-pool support, read the deposit token from poolInfo(pid).lpToken.
NEXT_PUBLIC_TADA_POOL_ID=0
# Block time in seconds for APR conversion. TADA is approximately 1s.
NEXT_PUBLIC_TADA_BLOCK_TIME_SECONDS=1
